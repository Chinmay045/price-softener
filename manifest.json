{
  "manifest_version": 3,
  "name": "Price Softener – Gift Price Privacy",
  "short_name": "Price Softener",
  "version": "1.0.0",
  "description": "Keep gift prices private while shopping with family on Indian stores. Checkout and payment always show the real price.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Price Softener",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.in/*",
        "https://amazon.in/*",
        "https://www.flipkart.com/*",
        "https://flipkart.com/*",
        "https://www.croma.com/*",
        "https://www.reliancedigital.in/*",
        "https://www.vijaysales.com/*",
        "https://www.tatacliq.com/*",
        "https://www.jiomart.com/*",
        "https://www.myntra.com/*",
        "https://www.ajio.com/*",
        "https://www.nykaa.com/*"
      ],
      "js": ["pricing.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-prices": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Switch softened prices on/off"
    }
  }
}
